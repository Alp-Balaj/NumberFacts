{
  "schemaVersion": 1,
  "vault": {
    "name": "brian-the-brain",
    "plansDir": "7 - Dev Folder/1. Projects/NumberFacts/Plans"
  },
  "commands": {
    "build": ["dotnet", "build"],
    "test": ["dotnet", "test"]
  },
  "maxParseRetries": 3,
  "maxCheckpointAttempts": 3,
  "roles": {
    "planner":     { "allowedTools": ["Read", "Write"], "maxTurns": 10, "timeoutSeconds": 300 },
    "implementer": { "allowedTools": ["Read", "Write", "Edit", "Bash(dotnet*)", "Bash(git status)", "Bash(git diff)"], "maxTurns": 20, "timeoutSeconds": 600 },
    "reconciler":  { "allowedTools": ["Read", "Write"], "maxTurns": 5, "timeoutSeconds": 180 },
    "verifier":    { "allowedTools": ["Read", "Write", "Bash(dotnet*)"], "maxTurns": 10, "timeoutSeconds": 300 }
  }
}